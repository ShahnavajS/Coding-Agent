# Production Coding Assistant environment template

# Backend host config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
WORKSPACE_PATH=./workspace
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_PROVIDER=ollama
SHELL_TIMEOUT_SECONDS=30

# Cloud providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Local / on-device model options
OLLAMA_BASE_URL=http://localhost:11434/api
LOCAL_MODEL_PATH=

# Web search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=brave
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_TTL_SECONDS=900
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=

# Docker sandbox validation
DOCKER_SANDBOX_ENABLED=false
DOCKER_SANDBOX_FAIL_ON_ERROR=false
DOCKER_SANDBOX_DEFAULT_TIMEOUT=90
DOCKER_SANDBOX_NETWORK=none
DOCKER_SANDBOX_PYTHON_IMAGE=python:3.12-slim
DOCKER_SANDBOX_NODE_IMAGE=node:22-alpine
DOCKER_SANDBOX_MEMORY=1g
DOCKER_SANDBOX_CPUS=1
DOCKER_SANDBOX_PIDS_LIMIT=128

# Logging / future telemetry
LOG_LEVEL=INFO
